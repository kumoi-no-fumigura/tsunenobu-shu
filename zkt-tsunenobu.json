   "jo": ""
  },
  {
   "id": "zkt-tsunenobu-0007",
   "pid": "873676",
   "pages": [
    88
   ],
   "no": null,
   "kotobagaki": "正月七口小松につけて經信卿の許へ、出羽辨",
   "author": "",
   "text": "白馬をまつ引物と思ふには忘やすらむけふの子日を",
