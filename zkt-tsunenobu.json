   "jo": ""
  },
  {
   "id": "zkt-tsunenobu-0016",
   "pid": "873676",
   "pages": [
    88
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ヘ庭の上に吹まふ風の微せば散つむ花を雲に見ましや",
